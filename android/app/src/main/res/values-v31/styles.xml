<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash API: same brand field as Flutter so there is no "first" different screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">50</item>
    </style>
</resources>
